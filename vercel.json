{
    "functions": {
        "app/api/chat/route.ts": {
            "memory": 512,
            "maxDuration": 300
        },
        "app/api/**/route.ts": {
            "memory": 256,
            "maxDuration": 10
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ]
}
